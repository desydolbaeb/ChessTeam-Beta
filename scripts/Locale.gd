static func t(key: String, language: String = "ru") -> String:
    var lang: String = "en" if language == "en" else "ru"
    var table: Dictionary = DATA.get(lang, DATA["ru"])
    return str(table.get(key, key))

static func format(key: String, value: Variant, language: String = "ru") -> String:
    return t(key, language) % value
